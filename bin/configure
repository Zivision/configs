#!/usr/bin/env -S emacs --script
(require 'subr-x)
(require 'ob-tangle)


(defvar project-dir
  (thread-first
    ;; Get project directory on machine
    (or load-file-name
        buffer-file-name)
    (file-name-directory)
    (directory-file-name)
    (file-name-directory)
    (file-truename)))

(add-to-list 'load-path (expand-file-name "build/doom/elisp" project-dir))
(require 'tangle-configs)

(tangle-configs-configure)
