    parser: argparse.ArgumentParser,
    arguments: dict[str, bool | str | None],
    target_type: type,
) -> None:
    # Checks for TARGET_TYPE in arguments
    checked_type: bool = any(
        isinstance(value, target_type) for value in arguments.values()
    )

