#!/usr/bin/env -S emacs --script
(require 'subr-x)
(require 'ob-tangle)
(require 'json)


(defvar paths
  (json-read-file
   (expand-file-name "paths.json"
                     (thread-first
                       ;; Get project directory on machine
                       (or load-file-name
                           buffer-file-name)
                       (file-name-directory)
                       (directory-file-name)
                       (file-name-directory)
                       (directory-file-name)
                       (file-name-directory)
                       (file-truename)))))

(add-to-list 'load-path (expand-file-name "doom/elisp" (alist-get `build paths)))
(require 'tangle-configs)

(tangle-configs-configure
 (alist-get `root paths)
 (alist-get `build paths))
